FROM node:22-bookworm

# Install core dependencies (Python for project-map-cli, curl/unzip for Bun)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-pip \
    curl \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Bun
ENV BUN_INSTALL=/usr/local/bun
RUN curl -fsSL https://bun.sh/install | bash \
    && ln -s $BUN_INSTALL/bin/bun /usr/local/bin/bun \
    && ln -s $BUN_INSTALL/bin/bunx /usr/local/bin/bunx

# Globally install the published NPM MCP servers
RUN npm install -g mcpx-go mcp-spec-cli

# Install Ground Truth CLI from local source (assuming this is still the source of truth)
COPY ground-truth-cli /tmp/ground-truth-cli
RUN cd /tmp/ground-truth-cli && npm install && npm run build && npm install -g .

# Install Project Map CLI (Python) from GitHub into a global venv
RUN python3 -m venv /opt/project-map-cli-env
RUN /opt/project-map-cli-env/bin/pip install --upgrade pip
RUN /opt/project-map-cli-env/bin/pip install git+https://github.com/benjamesmurray/project-map-cli.git

# Bake in the context files (Baseline)
RUN mkdir -p /etc/epochcli
COPY AGENTS.md /etc/epochcli/
COPY .editorconfig /etc/epochcli/

# Ensure the /workspace directory exists and we have a home for settings
RUN mkdir -p /workspace/.gemini

WORKDIR /workspace
