FROM node:22-bookworm

# Install core dependencies (Rust for map tool, curl/unzip for Bun)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-pip \
    curl \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Configure Pip to allow global installs (bypass PEP 668)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Install Bun
ENV BUN_INSTALL=/usr/local/bun
RUN curl -fsSL https://bun.sh/install | bash \
    && ln -s $BUN_INSTALL/bin/bun /usr/local/bin/bun \
    && ln -s $BUN_INSTALL/bin/bunx /usr/local/bin/bunx

# Install Project Map CLI, mcpx, Ground Truth CLI & Deliver CLI (Rust)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN cargo install mcpx-rust
RUN cargo install project-map-cli-rust
RUN cargo install ground-truth-cli-rust
RUN cargo install deliver-cli

# Bake in the context files (Baseline)
RUN mkdir -p /etc/epochcli
COPY AGENTS.md /etc/epochcli/
COPY .editorconfig /etc/epochcli/
COPY .epochcli/epochcli.jsonc /etc/epochcli/

# Ensure the /workspace directory exists and we have a home for settings
RUN mkdir -p /workspace/.gemini

WORKDIR /workspace
