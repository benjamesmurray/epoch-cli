{
  "$schema": "./config.json",
  "model": "local-main/qwen-27b",
  "side_model": "local-side/qwen-35b",
  "provider": {
    "local-main": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Main (Qwen 27B)",
      "options": {
        "baseURL": "http://localhost:8085/v1",
        "apiKey": "2250"
      },
      "models": {
        "qwen-27b": {
          "name": "Qwen 27B Coding",
          "limit": {
            "context": 32000,
            "output": 4096
          }
        }
      }
    },
    "local-side": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Side (Qwen 35B Clerk)",
      "options": {
        "baseURL": "http://localhost:8085/v1",
        "apiKey": "2250"
      },
      "models": {
        "qwen-35b": {
          "name": "Qwen 35B Clerk",
          "limit": {
            "context": 32000,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },
  "mcpx": {
    "enabled": true
  }
}
