        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "sc_todo_start"
    },
    {
      "description": "Complete a task",
      "inputSchema": {
        "properties": {
          "feature": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": ["string", "integer"]
